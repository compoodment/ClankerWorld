    "sourceSha256": {
      "src/ClankerWorld.Simulation/Playtest/Animals/PrivateWorldRuntime.WildAnimals.cs": "143170609f04ba67c30c0d71ed0eaa925347aa330b42a6840d5f824617417040",
      "src/ClankerWorld.Simulation/World/WorldSystemsContracts.cs": "72fc7eb85454af2771ee4fa47c640cd9ca40c9cd5af5f28e7ed015c915c08720",
      "tests/ClankerWorld.Simulation.Tests/Simulation/Playtest/WildForageIndexTests.cs": "db097359e56b70bb6559767d833b498b9bff3f275afa46f60c90293ec5df2c6d"
    },
    "boundaries": "Filtering, ordering and candidate-ID materialization for eight native animals. Cold includes one fresh ecology-state index per search. Generation, ticks, checkpoint encoding and replay are excluded.",
    "originalQuerySource": "internal static IOrderedEnumerable<MapResource> WildAnimalForageSources(SeededMap map, EcologyState ecology, AnimalState animal)\n    {\n        var feed = AnimalRules.Definition(animal.Species).DailyFeed;\n        return map.Resources.Where(source => source.NaturalObjectKind == \"wild_greens\" &&\n                ecology.Resources.Any(resource => resource.Id == source.Id && resource.Quantity >= feed) &&\n                map.FootDistance(animal.Position, source.Position) <= 12)\n            .OrderBy(source => map.FootDistance(animal.Position, source.Position)).ThenBy(source => source.Id, StringComparer.Ordinal);\n    }"
  },
