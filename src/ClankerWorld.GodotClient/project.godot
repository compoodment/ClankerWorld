; Engine configuration file.
; The Phase 2 Godot client renders signed owner projections and submits paired
; owner requests. It never owns or directly mutates simulation state.
config_version=5

[application]
config/name="ClankerWorld"
; Use the current product's private Windows user:// folder. The pre-release
; identifier reset deliberately starts a fresh owner registration.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/ClankerWorld"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[clankerworld]
world_url="http://127.0.0.1:5188"

[dotnet]
project/assembly_name="ClankerWorld.GodotClient"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
; Pixel art everywhere, including tooltips and other windows the engine
; creates on demand, is drawn without smoothing.
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
